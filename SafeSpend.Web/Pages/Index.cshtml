@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between
            align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-muted small fw-semibold mb-1">
            SafeSpend overview
        </p>
        <h1 class="display-6 fw-semibold mb-1">Your cash flow</h1>
        <p class="text-muted mb-0">
            See what is available now and what is coming next.
        </p>
    </div>
    <a class="btn btn-primary" asp-page="/Setup">
        Manage setup
    </a>
</div>

@if (Model.ScheduleError is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.ScheduleError
    </div>
}

@if (Model.PlaidDataError is not null)
{
    <div class="alert alert-warning" role="alert">
        @Model.PlaidDataError
        <a class="alert-link" asp-page="/Setup">Review setup</a>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100 shadow-sm">
            <div class="card-body">
                <p class="text-muted small mb-2">Current balance</p>
                <div class="h3 mb-2">
                    @(Model.CurrentBalanceCents.HasValue
                        ? IndexModel.FormatMoney(Model.CurrentBalanceCents.Value)
                        : "—")
                </div>
                <a class="small" asp-page="/Setup">
                    @(Model.IsPlaidConnected
                        ? "View connected accounts"
                        : "Connect a bank")
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100 shadow-sm">
            <div class="card-body">
                <p class="text-muted small mb-2">Safe to spend now</p>
                <div class="h3 mb-2 @(Model.Forecast is null
                    ? "text-muted"
                    : Model.Forecast.SafeToSpendNowCents >= 0
                        ? "text-success"
                        : "text-danger")">
                    @(Model.Forecast is null
                        ? "—"
                        : IndexModel.FormatMoney(
                            Model.Forecast.SafeToSpendNowCents))
                </div>
                <span class="small text-muted">
                    Through @Model.NextPaycheckDate?.ToString("MMMM d")
                </span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100 shadow-sm">
            <div class="card-body">
                <p class="text-muted small mb-2">Upcoming bills</p>
                <div class="h3 mb-2">
                    @(Model.Forecast is null
                        ? "—"
                        : IndexModel.FormatMoney(Model.UpcomingTotalCents))
                </div>
                <span class="small text-muted">
                    Before your next paycheck
                </span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card dashboard-stat h-100 shadow-sm">
            <div class="card-body">
                <p class="text-muted small mb-2">Next paycheck</p>
                <div class="h3 mb-2">
                    @(Model.PaycheckSchedule is null
                        ? "—"
                        : IndexModel.FormatMoney(
                            Model.PaycheckSchedule.AmountCents))
                </div>
                <span class="small text-muted">
                    @(Model.NextPaycheckDate?.ToString("MMM d, yyyy")
                        ?? "Add a schedule")
                </span>
            </div>
        </div>
    </div>
</div>

@if (Model.NeedsSetup || Model.ForecastError is not null)
{
    <div class="card border-primary-subtle bg-primary-subtle mb-4">
        <div class="card-body d-flex flex-column flex-md-row
                    justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="h5 mb-1">Finish your setup</h2>
                <p class="mb-0">@Model.SetupMessage</p>
            </div>
            <a class="btn btn-primary" asp-page="/Setup">
                Open setup
            </a>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between
                        align-items-center">
                <strong>Forecast</strong>
                <a class="small" asp-page="/Setup">Edit schedules</a>
            </div>

            @if (Model.ForecastError is not null)
            {
                <div class="card-body text-muted">
                    @Model.ForecastError
                </div>
            }
            else if (Model.Forecast is not null)
            {
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="rounded bg-body-tertiary p-3 h-100">
                                <p class="text-muted small mb-2">
                                    Available after next paycheck
                                </p>
                                <div class="h4 mb-1 @(Model.Forecast
                                    .AvailableFromNextPaycheckCents >= 0
                                    ? "text-success"
                                    : "text-danger")">
                                    @IndexModel.FormatMoney(
                                        Model.Forecast
                                            .AvailableFromNextPaycheckCents)
                                </div>
                                <span class="small text-muted">
                                    After bills and safety cushion
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="rounded bg-body-tertiary p-3 h-100">
                                <p class="text-muted small mb-2">
                                    Safety cushion
                                </p>
                                <div class="h4 mb-1">
                                    @IndexModel.FormatMoney(
                                        Model.PaycheckSchedule!.CushionCents)
                                </div>
                                <span class="small text-muted">
                                    Kept aside in the forecast
                                </span>
                            </div>
                        </div>
                    </div>

                    <h2 class="h6">Upcoming expenses</h2>
                    @if (Model.UpcomingOccurrences.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            No bills are scheduled before the following paycheck.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th>Due date</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var occurrence in
                                    Model.UpcomingOccurrences)
                                {
                                    <tr>
                                        <td>@occurrence.Name</td>
                                        <td>
                                            @occurrence.Date.ToString("MMM d")
                                        </td>
                                        <td class="text-end">
                                            @IndexModel.FormatMoney(
                                                occurrence.AmountCents)
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between
                        align-items-center">
                <strong>Connected accounts</strong>
                <a class="small" asp-page="/Plaid/Connect">View details</a>
            </div>
            @if (!Model.IsPlaidConnected)
            {
                <div class="card-body text-muted">
                    Connect a bank to see your checking and savings balances.
                </div>
            }
            else if (Model.ConnectedAccounts.Count == 0)
            {
                <div class="card-body text-muted">
                    No checking or savings accounts are available.
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                @foreach (var account in Model.ConnectedAccounts)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <strong>@account.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(account.Mask))
                                {
                                    <span class="text-muted">
                                        ····@account.Mask
                                    </span>
                                }
                                <small class="d-block text-muted">
                                    @account.Subtype
                                </small>
                            </div>
                            <strong>
                                @(account.CurrentBalance?.ToString("C")
                                    ?? account.AvailableBalance?.ToString("C")
                                    ?? "—")
                            </strong>
                        </div>
                    </div>
                }
                </div>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between
                align-items-center">
        <strong>Recent transactions</strong>
        @if (Model.IsPlaidConnected)
        {
            <div class="d-flex gap-2">
                <form method="post" asp-page-handler="SyncTransactions">
                    <button class="btn btn-sm btn-outline-primary"
                            type="submit">
                        Sync now
                    </button>
                </form>
                <a class="btn btn-sm btn-outline-secondary"
                   asp-page="/Plaid/Connect">
                    Manage connection
                </a>
            </div>
        }
        else
        {
            <a class="btn btn-sm btn-outline-secondary"
               asp-page="/Setup">
                Set up bank
            </a>
        }
    </div>

    @if (!Model.IsPlaidConnected)
    {
        <div class="card-body text-muted">
            Connect a bank to import transactions.
        </div>
    }
    else if (Model.RecentTransactions.Count == 0)
    {
        <div class="card-body text-muted">
            No synced transactions yet. Sync from the Plaid connection page.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var transaction in Model.RecentTransactions)
                {
                    <tr>
                        <td>
                            @(transaction.Date?.ToString("MMM d, yyyy") ?? "—")
                        </td>
                        <td>@transaction.Name</td>
                        <td>
                            @if (transaction.IsPending)
                            {
                                <span class="badge text-bg-warning">Pending</span>
                            }
                            else
                            {
                                <span class="text-muted">Posted</span>
                            }
                        </td>
                        <td class="text-end">
                            @IndexModel.FormatTransactionAmount(
                                transaction.Amount)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
