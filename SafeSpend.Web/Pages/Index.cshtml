@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="display-5 fw-semibold">SafeSpend</h1>
    <p class="text-muted">
        Paycheck-based cash-flow planning
    </p>
</div>

@if (Model.ScheduleError is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.ScheduleError
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card h-100 shadow-sm">
            <div class="card-header">
                <strong>Paycheck schedule</strong>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="SavePaycheckSchedule">
                    <div class="mb-3">
                        <label asp-for="PaycheckInput.NextPaycheckDate"
                               class="form-label">
                            Next paycheck
                        </label>
                        <input asp-for="PaycheckInput.NextPaycheckDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="PaycheckInput.NextPaycheckDate"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaycheckInput.FollowingPaycheckDate"
                               class="form-label">
                            Following paycheck
                        </label>
                        <input asp-for="PaycheckInput.FollowingPaycheckDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="PaycheckInput.FollowingPaycheckDate"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaycheckInput.AmountDollars"
                               class="form-label">
                            Paycheck amount
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="PaycheckInput.AmountDollars"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />
                        </div>
                        <span asp-validation-for="PaycheckInput.AmountDollars"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaycheckInput.CushionDollars"
                               class="form-label">
                            Safety cushion
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="PaycheckInput.CushionDollars"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control" />
                        </div>
                        <span asp-validation-for="PaycheckInput.CushionDollars"
                              class="text-danger"></span>
                    </div>

                    <button class="btn btn-primary" type="submit">
                        Save paycheck schedule
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100 shadow-sm">
            <div class="card-header">
                <strong>Bill schedule</strong>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="AddBill">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label asp-for="BillInput.Name" class="form-label">
                                Bill name
                            </label>
                            <input asp-for="BillInput.Name"
                                   class="form-control"
                                   placeholder="Rent" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="BillInput.NextDueDate"
                                   class="form-label">
                                Next due
                            </label>
                            <input asp-for="BillInput.NextDueDate"
                                   type="date"
                                   class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="BillInput.AmountDollars"
                                   class="form-label">
                                Amount
                            </label>
                            <input asp-for="BillInput.AmountDollars"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="BillInput.Frequency"
                                   class="form-label">
                                Frequency
                            </label>
                            <select asp-for="BillInput.Frequency"
                                    class="form-select">
                                @foreach (var frequency in
                                    Enum.GetValues<BillFrequency>())
                                {
                                    <option value="@frequency">
                                        @IndexModel.FormatFrequency(frequency)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-outline-primary" type="submit">
                            Add bill
                        </button>
                    </div>
                </form>

                @if (Model.BillSchedules.Count == 0)
                {
                    <p class="text-muted mt-4 mb-0">
                        Add bills to include them in the forecast.
                    </p>
                }
                else
                {
                    <div class="table-responsive mt-4">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Bill</th>
                                    <th>Next due</th>
                                    <th>Frequency</th>
                                    <th class="text-end">Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var bill in Model.BillSchedules)
                            {
                                <tr>
                                    <td>@bill.Name</td>
                                    <td>@bill.NextDueDate.ToString("MMM d, yyyy")</td>
                                    <td>
                                        @IndexModel.FormatFrequency(bill.Frequency)
                                    </td>
                                    <td class="text-end">
                                        @IndexModel.FormatMoney(bill.AmountCents)
                                    </td>
                                    <td class="text-end">
                                        <form method="post"
                                              asp-page-handler="DeleteBill">
                                            <input type="hidden" name="id"
                                                   value="@bill.Id" />
                                            <button class="btn btn-sm btn-link text-danger"
                                                    type="submit">
                                                Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.ForecastError is not null)
{
    <div class="alert alert-info" role="status">
        @Model.ForecastError
        @if (!Model.IsPlaidConnected)
        {
            <a asp-page="/Plaid/Connect" class="alert-link">
                Connect a bank
            </a>
        }
    </div>
}

@if (Model.Forecast is not null)
{
    <div class="alert alert-success">
        Forecast uses the connected checking and savings account balance.
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 text-muted">Safe to spend now</h2>

                    <div class="display-5 fw-bold
                        @(Model.Forecast.SafeToSpendNowCents >= 0
                            ? "text-success"
                            : "text-danger")">
                        @IndexModel.FormatMoney(
                            Model.Forecast.SafeToSpendNowCents)
                    </div>

                    <div class="mt-3 text-muted">
                        Through
                        @Model.NextPaycheckDate?.ToString("MMMM d")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 text-muted">
                        Available from next paycheck
                    </h2>

                    <div class="display-5 fw-bold
                        @(Model.Forecast.AvailableFromNextPaycheckCents >= 0
                            ? "text-success"
                            : "text-danger")">
                        @IndexModel.FormatMoney(
                            Model.Forecast.AvailableFromNextPaycheckCents)
                    </div>

                    <div class="mt-3 text-muted">
                        After upcoming bills and safety cushion
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Upcoming expenses</strong>
        </div>

        @if (Model.UpcomingOccurrences.Count == 0)
        {
            <div class="card-body text-muted">
                No bills are scheduled before the following paycheck.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Due date</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var occurrence in Model.UpcomingOccurrences)
                    {
                        <tr>
                            <td>@occurrence.Name</td>
                            <td>@occurrence.Date.ToString("MMM d, yyyy")</td>
                            <td class="text-end">
                                @IndexModel.FormatMoney(
                                    occurrence.AmountCents)
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Recent transactions</strong>
        @if (Model.IsPlaidConnected)
        {
            <a class="btn btn-sm btn-outline-secondary"
               asp-page="/Plaid/Connect">
                Manage connection
            </a>
        }
    </div>

    @if (Model.PlaidDataError is not null)
    {
        <div class="alert alert-danger m-3 mb-0" role="alert">
            @Model.PlaidDataError
        </div>
    }
    else if (!Model.IsPlaidConnected)
    {
        <div class="card-body text-muted">
            Connect a bank to import transactions.
        </div>
    }
    else if (Model.RecentTransactions.Count == 0)
    {
        <div class="card-body text-muted">
            No synced transactions yet. Use the connection page to sync Plaid.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var transaction in Model.RecentTransactions)
                {
                    <tr>
                        <td>
                            @(transaction.Date?.ToString("MMM d, yyyy") ?? "—")
                        </td>
                        <td>@transaction.Name</td>
                        <td>
                            @if (transaction.IsPending)
                            {
                                <span class="badge text-bg-warning">Pending</span>
                            }
                            else
                            {
                                <span class="text-muted">Posted</span>
                            }
                        </td>
                        <td class="text-end">
                            @IndexModel.FormatTransactionAmount(
                                transaction.Amount)
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
