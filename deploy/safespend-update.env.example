# Deployment settings for /usr/local/sbin/safespend-update.
SAFESPEND_REPOSITORY=ComputerComa/SafeSpend
SAFESPEND_APP_ROOT=/opt/safespend
SAFESPEND_SERVICE=safespend
SAFESPEND_USER=safespend
SAFESPEND_DATA_DIRECTORY=/var/lib/safespend
SAFESPEND_KEEP_RELEASES=3
# Set true only when you intentionally want an update to replace a customized
# /etc/systemd/system/safespend.service with the packaged default unit.
SAFESPEND_REPLACE_SERVICE=false
