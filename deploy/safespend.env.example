# Runtime configuration. Keep this file root-readable only.
ASPNETCORE_ENVIRONMENT=Production
# Use 0.0.0.0 for initial LAN access. Restrict the LXC with its firewall
# until a reverse proxy and public hostname are configured.
ASPNETCORE_URLS=http://0.0.0.0:5080

# Keep databases and Data Protection keys outside versioned releases.
SafeSpend__DataDirectory=/var/lib/safespend
# Set true only when a trusted reverse proxy is forwarding X-Forwarded-*.
SafeSpend__BehindProxy=false

# Set this to the public HTTPS reverse-proxy URL for Plaid callbacks.
SafeSpend__PlaidWebhookUrl=https://your-domain.example/api/plaid/webhook
# Include every host/IP used to reach the app, separated by semicolons.
# Example for initial LAN setup: 192.168.1.50;localhost;127.0.0.1
AllowedHosts=your-domain.example

Plaid__Environment=Production
Plaid__ClientId=replace-with-production-client-id
Plaid__Secret=replace-with-production-secret
